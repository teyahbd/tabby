{
	"name": "tabby",
	"version": "0.0.1",
	"private": true,
	"description": "A small desktop pet that lives in your browser.",
	"type": "module",
	"packageManager": "pnpm@9.0.0",
	"scripts": {
		"build": "node build.mjs",
		"typecheck": "tsc --noEmit",
		"test": "node --test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build && git diff --exit-code -- dist/",
		"prepare": "git config core.hooksPath .githooks"
	},
	"devDependencies": {
		"@types/chrome": "^0.0.287",
		"@types/node": "^22.10.2",
		"esbuild": "^0.24.2",
		"prettier": "^3.4.2",
		"typescript": "^5.7.2"
	}
}
